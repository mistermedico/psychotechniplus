{
  "name": "psychotechniplus",
  "version": "1.0.5",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist-check",
    "eas:whoami": "npx eas-cli@20.2.0 whoami",
    "eas:env:list": "npx eas-cli@20.2.0 env:list --environment production",
    "build:ios:production": "npx eas-cli@20.2.0 build --platform ios --profile production --non-interactive",
    "submit:ios:production": "npx eas-cli@20.2.0 submit --platform ios --profile production --latest --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/heebo": "^0.2.3",
    "@expo-google-fonts/suez-one": "^0.2.3",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~52.0.46",
    "expo-blur": "~14.0.3",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-purchases": "^10.2.0",
    "react-native-purchases-ui": "^10.2.0",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "^0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  }
}
